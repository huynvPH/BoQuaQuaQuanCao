<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FFFFFF"
    android:padding="28dp">

    <!-- Nút bấm trung tâm duy nhất -->
    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="BẬT TRỢ NĂNG"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0F172A" />

    <!-- Nút phụ tối giản mở khóa cài đặt trên Android 13+ -->
    <Button
        android:id="@+id/btnUnlockSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mở khóa cài đặt (Android 13+)"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:background="?android:attr/selectableItemBackground" />

</LinearLayout>
